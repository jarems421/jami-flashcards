{
  "name": "jami-flashcards",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:ai-release": "node --env-file-if-exists=.env.local scripts/check-ai-provider-release.mjs --live",
    "check:ai-benchmark": "node scripts/check-ai-benchmark.mjs",
    "check:paper-benchmark": "node scripts/check-paper-generation-benchmark.mjs",
    "corpus:report": "node --no-warnings scripts/corpus-report.mjs",
    "corpus:holdout": "node --no-warnings scripts/corpus-holdout.mjs",
    "corpus:experiment": "node --no-warnings scripts/corpus-experiment.mjs",
    "eval:exemplar": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/exemplar-run.ts",
    "check": "npm run typecheck && npm run lint && npm run check:sizes && npm run check:paper-benchmark && npm test",
    "verify:all": "npm run check && npm run build && npm run test:rules && npm run test:e2e",
    "emulators:free": "node scripts/free-emulator-ports.mjs",
    "test:rules": "npm run emulators:free && firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm run emulators:free && firebase emulators:exec --project demo-jami-browser --only auth,firestore,storage \"playwright test\"",
    "emulators:rules": "firebase emulators:start --only firestore,storage",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "audit:ai-endpoints": "node --env-file-if-exists=.env.local scripts/audit-ai-endpoints.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@napi-rs/canvas": "^0.1.100",
    "cheerio": "^1.1.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "js-draw": "^1.33.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "officeparser": "^7.2.1",
    "pdfjs-dist": "^6.0.227",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "ts-fsrs": "^5.3.2",
    "web-push": "^3.6.7",
    "workflow": "^4.8.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "tar": "7.5.19",
    "websocket-driver": "0.7.5"
  }
}

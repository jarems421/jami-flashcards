rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDemoAccount() {
      return isSignedIn() &&
        ('demo' in request.auth.token) &&
        request.auth.token.demo == true;
    }

    function isAllowedNotebookFile() {
      return request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
    }

    function isAllowedSourceFile() {
      return request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches(
          '(application/pdf|image/jpeg|image/png|image/webp|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.presentationml.presentation|text/plain)'
        );
    }

    function isAllowedVideoImport() {
      return request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('(video/mp4|video/mpeg|video/quicktime|video/webm)');
    }

    match /profilePhotos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{userId}/notebookFiles/{notebookId}/{fileName} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId) && !isDemoAccount() && isAllowedNotebookFile();
      allow delete: if isSelf(userId) && !isDemoAccount();
    }

    match /users/{userId}/sourceFiles/{sourceId}/{fileName} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId) && !isDemoAccount() && isAllowedSourceFile();
      allow delete: if isSelf(userId) && !isDemoAccount();
    }

    // An uploaded video is kept until the import is approved or discarded, so
    // that the timestamps on the draft cards point at something the student can
    // still watch while reviewing them. Approving, discarding, or a failed
    // generation all delete the object, and starting another import sweeps the
    // student's own expired ones.
    //
    // None of that covers a bucket-level accident, so this prefix also needs an
    // age-based lifecycle rule (delete after 2 days) configured on the bucket.
    // Storage lifecycle lives in bucket configuration rather than in these
    // rules, which is why it is written down here:
    //
    //   gcloud storage buckets update gs://<bucket> --lifecycle-file=<file>
    //   { "rule": [{ "action": { "type": "Delete" },
    //                "condition": { "age": 2,
    //                               "matchesPrefix": ["users/"] } }] }
    //
    // Scope the prefix to videoCardImports paths before applying it; nothing
    // else under users/ is safe to delete on age.
    match /users/{userId}/videoCardImports/{jobId}/{fileName} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId) && !isDemoAccount() && isAllowedVideoImport();
      allow delete: if isSelf(userId) && !isDemoAccount();
    }

    // Files used to create flashcard drafts are temporary. The server deletes
    // them when the student approves or discards the generated batch.
    match /users/{userId}/cardSourceImports/{jobId}/{fileName} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId) && !isDemoAccount() && isAllowedSourceFile();
      allow delete: if isSelf(userId) && !isDemoAccount();
    }

    // AI-created images are written and deleted only by server routes using
    // Firebase Admin. The owner may view the private object after the route
    // has returned its storage path.
    match /users/{userId}/assistantImages/{assetId}/{fileName} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /users/{userId}/generatedPaperAssets/{paperId}/{assetId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // Frozen assessment evidence is intentionally not exposed as a storage
    // URL. Sanitized warnings and results are projected by authenticated APIs.
    match /users/{userId}/practicePaperMarkingEvidence/{attemptId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Official imports and held-out benchmark artifacts are not student
    // assets. Owner review is projected through authenticated server APIs.
    match /internal/examFormatImports/{allPaths=**} {
      allow read, write: if false;
    }

    match /internal/paperGenerationBenchmarks/{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/artifacts/ai-benchmark-report*.json
# Derived corpus records. Never committed: they carry third-party dataset
# content whose licences have not all been verified.
/artifacts/corpus
# Derived evaluation results. Never committed: they quote third-party dataset
# content and are regenerated by corpus:experiment.
/artifacts/evaluation

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

# env files (keep the documented placeholder template)
.env*
!.env.example

# typescript
tsconfig.tsbuildinfo

# dev logs
.next-dev.log
next-dev-*.log
.tmp*.log

# vercel
.vercel
.vercel*.env

# firebase
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts
/.swc

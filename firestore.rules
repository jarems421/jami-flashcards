rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDemoAccount() {
      return isSignedIn() &&
        ('demo' in request.auth.token) &&
        request.auth.token.demo == true;
    }

    function isOwnedByRequestAuth(data) {
      return isSignedIn() &&
        (('userId' in data) || ('uid' in data)) &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        (!('uid' in data) || data.uid == request.auth.uid);
    }

    function canReadOwnedData(data) {
      return isSignedIn() &&
        (
          (('userId' in data) && data.userId == request.auth.uid) ||
          (('uid' in data) && data.uid == request.auth.uid)
        );
    }

    function containsOnlyPublicPracticePaperData(data) {
      return !('markScheme' in data) ||
        (
          data.markScheme is map &&
          (
            !('items' in data.markScheme) ||
            (data.markScheme.items is list && data.markScheme.items.size() == 0)
          )
        );
    }

    function isOwnedDeckData(data) {
      return (('userId' in data) || ('uid' in data)) &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        (!('uid' in data) || data.uid == request.auth.uid);
    }

    function deckExistsAndIsOwned(deckId) {
      return deckId is string &&
        exists(/databases/$(database)/documents/decks/$(deckId)) &&
        isOwnedDeckData(get(/databases/$(database)/documents/decks/$(deckId)).data);
    }

    match /decks/{deckId} {
      allow read: if canReadOwnedData(resource.data);
      allow create: if !isDemoAccount() && createsOwnDeck();
      allow update: if !isDemoAccount() && ownsDeck() && updatesOwnDeck();
      allow delete: if !isDemoAccount() && ownsDeck();

      function ownsDeck() {
        return isOwnedByRequestAuth(resource.data);
      }

      function createsOwnDeck() {
        return isOwnedByRequestAuth(request.resource.data);
      }

      function updatesOwnDeck() {
        return isOwnedByRequestAuth(request.resource.data);
      }
    }

    match /cards/{cardId} {
      allow read: if canReadOwnedData(resource.data);
      allow create: if !isDemoAccount() &&
        isOwnedByRequestAuth(request.resource.data) &&
        deckExistsAndIsOwned(request.resource.data.deckId);
      allow update: if isOwnedByRequestAuth(resource.data) &&
        isOwnedByRequestAuth(request.resource.data) &&
        request.resource.data.deckId == resource.data.deckId &&
        (
          !isDemoAccount() ||
          (
            request.resource.data.front == resource.data.front &&
            request.resource.data.back == resource.data.back &&
            request.resource.data.tags == resource.data.tags &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.userId == resource.data.userId
          )
        );
      allow delete: if !isDemoAccount() && isOwnedByRequestAuth(resource.data);
    }

    // Official format profiles, imports, held-out papers, model output, spend
    // and human review evidence are available only through owner-authenticated
    // server routes. Firebase clients cannot enumerate or mutate them.
    match /examFormatProfiles/{profileId} {
      allow read, write: if false;
      match /versions/{versionId} { allow read, write: if false; }
    }
    match /examFormatCatalogue/{entryId} { allow read, write: if false; }
    match /examFormatCatalogueControl/{controlId} { allow read, write: if false; }
    match /examFormatImports/{importId} { allow read, write: if false; }
    match /examFormatReferenceFingerprints/{profileId} { allow read, write: if false; }
    match /paperGenerationBenchmarkRuns/{runId} {
      allow read, write: if false;
      match /cases/{caseId} {
        allow read, write: if false;
        match /reviewAudits/{reviewId} { allow read, write: if false; }
      }
    }
    match /paperGenerationBenchmarkBaselines/{baselineId} { allow read, write: if false; }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update, delete: if isSelf(userId) && !isDemoAccount();

      match /goals/{goalId} {
        allow read: if isSelf(userId);
        allow create, delete: if isSelf(userId) && !isDemoAccount();
        allow update: if isSelf(userId);
      }

      match /stars/{starId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId) && !isDemoAccount();
      }

      match /studyActivity/{dayKey} {
        allow read, create, update: if isSelf(userId);
        allow delete: if isSelf(userId) && !isDemoAccount();
      }

      match /studyState/{documentId} {
        allow read, create, update: if isSelf(userId);
        allow delete: if isSelf(userId) && !isDemoAccount();
      }

      match /constellations/{constellationId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId) && !isDemoAccount();
      }

      match /constellationState/{stateId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId) && !isDemoAccount();
      }

      match /notificationPreferences/{documentId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /topics/{topicId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /questions/{questionId} {
        allow read, write: if false;
      }

      match /attempts/{attemptId} {
        allow read, write: if false;
      }

      match /tutorThreads/{threadId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /tutorMessages/{messageId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /assistantThreads/{threadId} {
        allow read: if isSelf(userId);
        // Chat turns carry server-issued Tutor illustration entitlements and
        // routing state, so clients may never forge or mutate them directly.
        allow create, update, delete: if false;
      }

      match /assistantMessages/{messageId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }

      match /assistantRouteState/{threadId} {
        allow read, write: if false;
      }

      match /masteryEvents/{eventId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /generatedContentDrafts/{draftId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /sources/{sourceId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /studyFolders/{folderId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /notebooks/{notebookId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /notebookPages/{pageId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      // Full-fidelity page ink, split out of the page record so opening a
      // notebook does not fetch every stroke of every page. Same owner-only
      // access as the page it belongs to.
      match /notebookPageInk/{pageId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /notebookFiles/{fileId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /practiceSets/{practiceSetId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /pastPapers/{pastPaperId} {
        allow read: if isSelf(userId) &&
          containsOnlyPublicPracticePaperData(resource.data);
        // Upload creation may originate in the browser, but no assessment
        // definition, answer-bearing guide, result or timing transition does.
        allow create: if isSelf(userId) && !isDemoAccount() &&
          containsOnlyPublicPracticePaperData(request.resource.data) &&
          request.resource.data.origin == 'uploaded' &&
          request.resource.data.status == 'ready' &&
          request.resource.data.questions is list &&
          request.resource.data.questions.size() == 0 &&
          request.resource.data.totalMarks == 0;
        allow update, delete: if false;
      }

      // Answer-bearing rubrics and retry checkpoints are server-owned. The
      // browser receives only a deliberately projected paper/job document.
      match /practicePaperSecrets/{paperId} {
        allow read, write: if false;
      }

      match /practicePaperJobArtifacts/{jobId} {
        allow read, write: if false;
      }

      // Immutable submission evidence, marking workflow state and provider
      // outputs are available only through authenticated server routes.
      match /practicePaperEvidence/{attemptId} {
        allow read, write: if false;
      }

      match /practicePaperMarkingJobs/{jobId} {
        allow read, write: if false;
      }

      match /practicePaperMarkingJobArtifacts/{jobId} {
        allow read, write: if false;
      }

      match /practicePaperAttempts/{attemptId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }

      match /practicePaperDeadlineSnapshots/{snapshotId} {
        allow read: if isSelf(userId);
        // Server-authenticated action routes create immutable deadline
        // evidence from authoritative stored pages and server time.
        allow create, update, delete: if false;
      }

      // Durable paper jobs contain server-only workflow input, allowance and
      // retry state. Students read their safe projection through the
      // authenticated job API rather than accessing these records directly.
      match /practicePaperJobs/{jobId} {
        allow read, write: if false;
      }

      // Embeddings and extracted chunks are server-owned private indexes. The
      // client receives only the grounded answer and source receipt.
      match /sourceChunks/{chunkId} {
        allow read, write: if false;
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if isSelf(userId) && !isDemoAccount();
      }

      match /decks/{deckId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId) &&
          !isDemoAccount() &&
          request.resource.data.deckId == deckId &&
          deckExistsAndIsOwned(deckId);

        match /attempts/{attemptId} {
          allow read, delete: if isSelf(userId);
          allow create, update: if isSelf(userId) &&
            !isDemoAccount() &&
            request.resource.data.deckId == deckId &&
            deckExistsAndIsOwned(deckId);
        }
      }
    }
  }
}
